# MongoDB — sessions + audit logs only, never file contents
MONGODB_URI=mongodb://127.0.0.1:27017/safeprint

# 64 hex chars (32 bytes). REQUIRED in production — the server refuses to start
# without it. A fixed (public!) dev key is derived if unset in development.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=

# "local" (encrypted temp dir, default) or "gcs"
STORAGE_DRIVER=local
LOCAL_STORE_DIR=.safeprint-store

# Only needed when STORAGE_DRIVER=gcs (also run: npm i @google-cloud/storage)
GCS_BUCKET=

# Optional: shared rate-limit counters (survive restarts, hold across
# instances). Unset = in-memory limiter, fine for a single dev process.
REDIS_URL=

# Session lifetime + cleanup cadence (defaults: 30 min TTL, sweep every 60s)
SESSION_TTL_SECONDS=1800
CLEANUP_INTERVAL_MS=60000

# How long one OTP stays valid (citizen can regenerate), and how long the
# citizen has to tap Allow after the shop enters it.
OTP_TTL_SECONDS=600
APPROVAL_TIMEOUT_SECONDS=120

# Dev/test only: skip the citizen's Allow tap. Ignored when NODE_ENV=production.
SAFEPRINT_AUTO_APPROVE=

# --- Word files + shop-side editing --------------------------------------
# A self-hosted ONLYOFFICE Document Server converts Word uploads to PDF and
# hosts the Word editor (see docker-compose.yml). Leave unset to refuse Word
# uploads; the photo/page editor works without it.
ONLYOFFICE_URL=
# Must equal the Document Server's JWT_SECRET.
ONLYOFFICE_JWT_SECRET=
# How the Document Server reaches THIS app (server-to-server). Defaults to the
# URL each request came in on; in docker dev use http://host.docker.internal:3000
SAFEPRINT_INTERNAL_URL=
# One-time extra session time when the citizen allows an edit (default 15 min).
EDIT_TTL_EXTENSION_SECONDS=900
