# MongoDB — sessions + audit logs only, never file contents
MONGODB_URI=mongodb://127.0.0.1:27017/safeprint

# 64 hex chars (32 bytes). REQUIRED in production — the server refuses to start
# without it. A fixed (public!) dev key is derived if unset in development.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=

# "local" (encrypted temp dir, default) or "gcs"
STORAGE_DRIVER=local
LOCAL_STORE_DIR=.safeprint-store

# Only needed when STORAGE_DRIVER=gcs (also run: npm i @google-cloud/storage)
GCS_BUCKET=

# Optional: shared rate-limit counters (survive restarts, hold across
# instances). Unset = in-memory limiter, fine for a single dev process.
REDIS_URL=

# Session lifetime + cleanup cadence (defaults: 30 min TTL, sweep every 60s)
SESSION_TTL_SECONDS=1800
CLEANUP_INTERVAL_MS=60000

# How long one OTP stays valid (citizen can regenerate), and how long the
# citizen has to tap Allow after the shop enters it.
OTP_TTL_SECONDS=600
APPROVAL_TIMEOUT_SECONDS=120

# Dev/test only: skip the citizen's Allow tap. Ignored when NODE_ENV=production.
SAFEPRINT_AUTO_APPROVE=

# --- Word files + shop-side editing --------------------------------------
# A self-hosted ONLYOFFICE Document Server converts Word uploads to PDF and
# hosts the Word editor (see docker-compose.yml). Leave unset to refuse Word
# uploads; the photo/page editor works without it.
ONLYOFFICE_URL=
# Must equal the Document Server's JWT_SECRET.
ONLYOFFICE_JWT_SECRET=
# How the Document Server reaches THIS app (server-to-server). Defaults to the
# URL each request came in on; in docker dev use http://host.docker.internal:3000
SAFEPRINT_INTERNAL_URL=
# One-time extra session time when the citizen allows an edit (default 15 min).
EDIT_TTL_EXTENSION_SECONDS=900
# Word conversions at once per app process, how many more may queue, and how
# long a queued upload waits before getting "busy, try again" (503).
WORD_CONVERSION_CONCURRENCY=2
WORD_CONVERSION_QUEUE=10
WORD_CONVERSION_WAIT_MS=20000

# --- Abuse limits + retention ----------------------------------------------
# Proxies in front of the app that APPEND to X-Forwarded-For (nginx, load
# balancer). The client IP is taken this many entries from the right; the
# client-supplied part is never trusted. 0 = nothing in front (not advised).
TRUST_PROXY_HOPS=1
# Failed OTP checks per minute (service-wide) before unpaired verification
# pauses for a minute. Registered counters are never braked.
VERIFY_GLOBAL_MISS_LIMIT=300
# Failed checks per minute per registered counter on sessions not its own.
VERIFY_COUNTER_MISS_LIMIT=30
# Every stranger-visible verification failure takes at least this long (ms),
# so timing can't reveal which share codes exist.
VERIFY_FAIL_FLOOR_MS=250
# Per-IP limits, sized for mobile carriers sharing one IP across many phones.
LIMIT_UPLOAD_PER_IP_HOUR=60
LIMIT_UPLOAD_PER_DEVICE_HOUR=10
LIMIT_WORD_UPLOAD_PER_IP_HOUR=20
LIMIT_VERIFY_PER_IP_MINUTE=60
LIMIT_STATUS_STREAM_PER_IP_MINUTE=120
LIMIT_SHOP_LOOKUP_PER_IP_MINUTE=120
# Ended sessions keep a scrubbed record this many days; audit entries likewise.
SESSION_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=90
