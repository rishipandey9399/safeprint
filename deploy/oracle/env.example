# SafePrint on one server — copy to .env (same folder) and fill in.
#   cp env.example .env && chmod 600 .env
# Generate each secret with:
#   openssl rand -hex 32
# Keep a copy of this file somewhere safe (password manager): without
# MASTER_KEY nothing in the database can be decrypted, and without
# BACKUP_PASSPHRASE the backups can't be restored.

# Public names, both pointing (DNS A record) at the server's public IP.
APP_DOMAIN=print.example.com
DOCS_DOMAIN=docs.example.com
# Let's Encrypt sends certificate-expiry warnings here.
ACME_EMAIL=you@example.com

# 64 hex chars. Encrypts every document key and keys the OTPs.
MASTER_KEY=
# Shared between the app and the ONLYOFFICE Document Server.
ONLYOFFICE_JWT_SECRET=

# Database passwords (hex only: they go inside a connection URL).
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=

# Encrypts the nightly database backups.
BACKUP_PASSPHRASE=
# How many days of backups to keep on the server, and when to run (UTC hour;
# 21 = 02:30 IST).
BACKUP_KEEP_DAYS=7
BACKUP_HOUR_UTC=21

# Optional: copy each backup to Oracle Object Storage (free up to 20 GB).
# Endpoint: https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
# Access/secret key: Profile → Customer secret keys → Generate secret key.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=ap-hyderabad-1
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
